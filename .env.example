# Hindsight (Cloud dashboard: https://ui.hindsight.vectorize.io -> copy your API URL + key)
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BANK_ID=brewline-demo-2

# Groq (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Set to 1 to run fully offline with fake memory + fake LLM (for UI work / tests)
DEMO_MOCK=0

# Model configuration (pin single model with no cascade)
FORCE_MODEL=qwen/qwen3.8-27b

# Demo date anchor
DEMO_TODAY=2026-09-28

# Recall memory cap (top N merged memories)
RECALL_CAP=14

# Set to 1 to force cached responses for all demo beats (fully offline presentation)
DEMO_CACHE_ONLY=0
